{
	# HTTP/3 (QUIC on UDP/443) causes ERR_SSL_PROTOCOL_ERROR in some
	# browsers and Windows Schannel clients. Keep HTTPS on TCP only.
	servers {
		protocols h1 h2
	}
}

https://irangerayeh.ir {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
